{
  "name": "onewinq-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for OneWinq digital identity and team platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeds/seed.js",
