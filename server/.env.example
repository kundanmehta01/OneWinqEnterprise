# OneWinq Backend Environment Configuration

# Server
NODE_ENV=development
PORT=5000
APP_NAME=OneWinq
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PUBLIC_PROFILE_BASE_URL=http://localhost:3000/p

# Database
MONGODB_URI=mongodb://localhost:27017/onewinq_db
MONGODB_DEBUG=false

# Authentication & Security
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars_long_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars_long_12345
JWT_REFRESH_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=12
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=500 # 500 requests per window
AUTH_RATE_LIMIT_MAX_REQUESTS=10 # 10 requests per window for login/auth

# Email Service (Nodemailer / SMTP)
EMAIL_PROVIDER=console # 'smtp' | 'console' | 'mock'
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM_NAME="OneWinq Team"
EMAIL_FROM_ADDRESS="no-reply@onewinq.com"

# Media Storage Provider ('local' | 'cloudinary' | 's3')
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOAD_DIR=./uploads
AWS_S3_BUCKET=onewinq-assets
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Cloudinary Storage (Active when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=onewinq

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./logs
